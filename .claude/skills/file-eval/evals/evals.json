        },
        {
          "type": "contains_match",
          "pattern": "Security & Compliance"
        },
        {
          "type": "contains_match",
          "pattern": "FinOps & Cost Efficiency"
        },
        {
          "type": "contains_match",
          "pattern": "The Definitive Best-of-Breed Document"
        }
      ]
    },
    {
      "name": "structured_5_pillar_scoring_eval",
      "prompt": "/file-eval \"2\"",
