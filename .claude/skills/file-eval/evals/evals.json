        {
          "type": "contains_match",
          "pattern": "Production & Ops Realist"
        },
        {
          "type": "contains_match",
          "pattern": "Chief Arbiter"
        },
        {
          "type": "contains_match",
          "pattern": "The Definitive Best-of-Breed Document"
        },
        {
          "type": "contains_match",
          "pattern": "Expert Evaluator Final Verdict"
        }
      ]
    },
    {
